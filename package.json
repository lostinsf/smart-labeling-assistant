{
  "name": "smart-labeling-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "worker:dev": "wrangler dev workers/index.ts --port 8787",
    "worker:dev:remote": "wrangler dev workers/index.ts --port 8787 --remote",
    "worker:deploy": "wrangler deploy",
    "pages:deploy": "wrangler pages deploy dist",
    "cf:build": "npm run build",
    "cf:deploy": "npm run worker:deploy && npm run pages:deploy"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wrangler": "^4.9.0"
  }
}
